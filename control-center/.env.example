# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://mcc:mcc_dev_pw@localhost:5432/mcc
# Admin login. Generate with: npm run hash-password -- 'your-password'
# In .env files every "$" in the hash must be escaped as "\$" (Next.js expands $VARS); not needed in hosting dashboards.
ADMIN_EMAIL=ceo@example.com
ADMIN_PASSWORD_HASH=
# 32+ random chars. e.g. openssl rand -base64 48
SESSION_SECRET=
# Protects /api/cron. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── AI agent engine (Claude API) ─────────────────────────────────────
# Without this, agent tasks are queued with status "awaiting_credentials" — nothing is simulated.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Shopify (Admin API, custom app) ──────────────────────────────────
SHOPIFY_STORE_DOMAIN=            # your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=             # scopes: read_orders, read_customers, read_products

# ── Google Analytics 4 (Data API, service account) ───────────────────
GA4_PROPERTY_ID=                 # numeric property id
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=      # PEM private key, \n-escaped

# ── Google Search Console (same service account, added as user on property)
GSC_SITE_URL=                    # e.g. sc-domain:example.com

# ── Meta Marketing API ───────────────────────────────────────────────
META_ACCESS_TOKEN=               # system-user token: ads_read (+ ads_management only for publishing)
META_AD_ACCOUNT_ID=              # act_1234567890
